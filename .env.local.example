TURSO_DATABASE_URL=file:./local.db
TURSO_AUTH_TOKEN=
AUTH_SECRET=replace-with-openssl-rand-base64-32
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
ADMIN_SEED_EMAILS=a@ucsc.edu,b@ucsc.edu,c@ucsc.edu
# Exact non-ucsc.edu addresses that may sign in (verified Google accounts only),
# comma-separated. Leave empty to allow @ucsc.edu only.
AUTH_EXTRA_ALLOWED_EMAILS=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Event import API (docs/import.md). Leave empty to keep it off; generate with openssl rand -base64 32.
EVENT_IMPORT_TOKEN=
# Event images (lib/storage.ts): the Vercel Blob store's read-write token. Leave
# empty to keep image uploads off; existing image URLs still display.
BLOB_READ_WRITE_TOKEN=
# Search engine ownership checks (lib/site.ts), optional. Google Search Console's
# HTML-tag method: the content="..." value only. Bing Webmaster Tools: msvalidate.01.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
